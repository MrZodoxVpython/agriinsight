PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Gunakan connection string Supabase Pooler (IPv4) agar bisa diakses dari Vercel.
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Opsional. Bila kosong, secret JWT diturunkan otomatis dari DATABASE_URL.
# JWT_SECRET=ganti-dengan-string-acak-panjang
